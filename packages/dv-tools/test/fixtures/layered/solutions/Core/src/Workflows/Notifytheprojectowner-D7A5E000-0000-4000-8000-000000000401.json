{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "dvt_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      },
      "shared_office365": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "dvt_office365"
        },
        "api": {
          "name": "shared_office365"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_project_changes": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "dvt_project",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/filteringattributes": "dvt_isactive,dvt_budget",
              "subscriptionRequest/filterexpression": "statecode eq 0"
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Get_the_customer": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "host": {
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "GetItem",
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
            },
            "parameters": {
              "entityName": "accounts",
              "recordId": "@triggerOutputs()?['body/_dvt_accountid_value']"
            },
            "authentication": "@parameters('$authentication')"
          }
        },
        "Is_the_project_active": {
          "runAfter": {
            "Get_the_customer": [
              "Succeeded"
            ]
          },
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@triggerOutputs()?['body/dvt_isactive']",
                  true
                ]
              }
            ]
          },
          "actions": {
            "List_the_open_tasks": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "ListRecords",
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "tasks",
                  "$filter": "_regardingobjectid_value eq @{triggerOutputs()?['body/dvt_projectid']}"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Each_open_task": {
              "runAfter": {
                "List_the_open_tasks": [
                  "Succeeded"
                ]
              },
              "type": "Foreach",
              "foreach": "@outputs('List_the_open_tasks')?['body/value']",
              "actions": {
                "Reset_the_effort": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "entityName": "tasks",
                      "recordId": "@items('Each_open_task')?['activityid']",
                      "item/dvt_effort": 0
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            }
          },
          "else": {
            "actions": {
              "Send_an_email_to_the_owner": {
                "runAfter": {},
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_office365",
                    "operationId": "SendEmailV2",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365"
                  },
                  "parameters": {
                    "emailMessage/To": "@outputs('Get_the_customer')?['body/emailaddress1']",
                    "emailMessage/Subject": "Project stopped",
                    "emailMessage/Body": "<p>The project was stopped.</p>"
                  },
                  "authentication": "@parameters('$authentication')"
                }
              }
            }
          }
        },
        "By_budget": {
          "runAfter": {
            "Is_the_project_active": [
              "Succeeded"
            ]
          },
          "type": "Switch",
          "expression": "@triggerOutputs()?['body/dvt_budget']",
          "cases": {
            "Large": {
              "case": 100000,
              "actions": {
                "Raise_a_project_event": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "host": {
                      "connectionName": "shared_commondataserviceforapps",
                      "operationId": "PerformUnboundAction",
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                    },
                    "parameters": {
                      "actionName": "dvt_ProjectEvent",
                      "item/ProjectId": "@triggerOutputs()?['body/dvt_projectid']"
                    },
                    "authentication": "@parameters('$authentication')"
                  }
                }
              }
            }
          },
          "default": {
            "actions": {
              "Mark_the_project_reviewed": {
                "runAfter": {},
                "type": "OpenApiConnection",
                "inputs": {
                  "host": {
                    "connectionName": "shared_commondataserviceforapps",
                    "operationId": "UpdateRecord",
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                  },
                  "parameters": {
                    "entityName": "dvt_projects",
                    "recordId": "@triggerOutputs()?['body/dvt_projectid']",
                    "item/dvt_isactive": true
                  },
                  "authentication": "@parameters('$authentication')"
                }
              }
            }
          }
        }
      },
      "outputs": {}
    },
    "templateName": ""
  },
  "schemaVersion": "1.0.0.0"
}
